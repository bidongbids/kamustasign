{
  "expo": {
    "name": "LCSign",
    "slug": "kamustasign",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF7EF"
      }
    },
    "plugins": [
      "expo-font",
      "expo-status-bar"
    ]
  }
}
