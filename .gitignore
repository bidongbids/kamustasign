# Node / Expo
node_modules/
.expo/
dist/
web-build/
*.log
npm-debug.*

# Python / ML
venv/
venv-convert/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Env files - never commit secrets
.env
.env.local

# OS junk
.DS_Store
Thumbs.db

# Large datasets - don't commit raw video/image data
ml/data/
ml/datasets/
*.mp4
# ...except the FSL "How to make it" clips (FSL-105, CC BY 4.0, which allows
# sharing). The ASL word clips stay out: their licenses are research-only and
# this repository is public, so they go up locked in
# locked-media/asl-words.lcpack (scripts/reference-clips.mjs).
!public/reference/fsl-words/*.mp4
*.avi
# Training checkpoints - too large for git; regenerate with the ml/scripts
# pipeline (see docs/FSL_MODEL_GUIDE.md / docs/NUMBERS_MODEL_GUIDE.md).
# The deployed web models (public/model, public/word-model, public/fsl-model)
# ARE committed: the fused exports are ~9 MB each and the app can't bundle
# without their label_classes.json.
ml/models/
ml/**/*.task

# Separate upstream repo + datasets, not part of this project's source
ml/SignAvatars/

# Office/PDF working drafts
*.docx
*.pdf
*.pptx
_pptx_edit/
ml/ab_test/*.keras
ml/ab_test/*.npy

# Database backups (npm run db:backup) - names, emails, password hashes
backups/

# Built by electron/write-server-config.mjs from .env
electron/server.json

# Android release key settings (path + passwords) - keep out of git
mobile/android/keystore.properties
*.jks
*.keystore

# Red-team scripts: test-project keys, test accounts, outputs
scripts/redteam/env.json
scripts/redteam/creds.json
scripts/redteam/seed.sql
scripts/redteam/results*.json
scripts/redteam/dist-rt/
scripts/redteam/xss-*.png
