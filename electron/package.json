{
  "name": "kamustasign-electron",
  "version": "1.2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:prod": "set KAMUSTASIGN_PROD=1&& electron ."
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": false
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "build": {
    "appId": "com.nmsc.kamustasign",
    "productName": "LCSign",
    "files": [
      "main.js",
      "preload.js",
      "server.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "../dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "artifactName": "LCSign-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://lcsign-updates.invalid/"
      }
    ]
  }
}
