# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
# EXPO_PUBLIC_ prefix is required for Expo to expose these to client code.
# The anon key is safe to ship in the client bundle by design; Row Level
# Security policies (not this key) are what actually restrict access.

EXPO_PUBLIC_SUPABASE_URL=https://grygsbwblnneqpfjnwvu.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_V_UekaQziIB8ZnkZ_kCvJQ_KaEMClKl

# Translation runs on MyMemory (free, no account needed - see
# src/lib/translate.ts). Optional: leave blank for 5,000 chars/day
# anonymously, or set any email-shaped string to raise that to 50,000/day
# (not verified, just used to raise the quota).
EXPO_PUBLIC_MYMEMORY_EMAIL=
# Video call TURN relay (optional but strongly recommended for demos: without
# it, calls between different networks - school Wi-Fi, mobile data - often
# fail to connect). Free tier: https://www.metered.ca/stun-turn -> create an
# app -> either paste its credentials API URL (short-lived credentials, fetched
# when a call starts - preferred):
#   https://<your-app>.metered.live/api/v1/turn/credentials?apiKey=<key>
EXPO_PUBLIC_TURN_CREDENTIALS_URL=
# ...or copy the TURN URLs and static credentials here.
EXPO_PUBLIC_TURN_URLS=
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=

# Show "Continue with Google" on the student sign-in screen. Turn the Google
# provider on in Supabase (Authentication -> Providers) first, then set "true".
EXPO_PUBLIC_GOOGLE_SIGNIN=
